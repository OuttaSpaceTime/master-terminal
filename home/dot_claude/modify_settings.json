  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Bash(solve-allow list)",
      "Bash(solveit-health:*)",
      "Bash(bin/rails test:*)",
      "Bash(bin/rails db:migrate:status:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle show:*)",
      "Bash(npx ng test:*)",
      "Bash(npx ng lint:*)",
      "Bash(npx editorconfig-checker:*)",
      "Bash(scripts/srs-pressure:*)",
      "Bash(scripts/wiki-due:*)",
      "Bash(scripts/anki-sync:*)",
      "Bash(scripts/study-calibration:*)",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/solveit/hooks/solve-init.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/solveit/hooks/edit-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/solveit/hooks/bash-guard.py"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/solveit/hooks/log-reads.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
