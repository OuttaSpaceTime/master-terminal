  "statusLine": {
    "type": "command",
    "command": "bash /home/felix/.claude/statusline-script.sh"
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
