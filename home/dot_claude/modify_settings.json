    "frontend-design@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false
  }
}
''', object_pairs_hook=collections.OrderedDict)

DEFAULTS = json.loads(r'''
{
  "model": "opus[1m]",
  "outputStyle": "solveit",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:light-high-contrast",
  "verbose": true,
  "preferredNotifChannel": "kitty",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
''', object_pairs_hook=collections.OrderedDict)

live = sys.stdin.read().strip()
out = json.loads(live, object_pairs_hook=collections.OrderedDict) if live else collections.OrderedDict()
out.update(MANAGED)
for key, value in DEFAULTS.items():
    out.setdefault(key, value)
sys.stdout.write(json.dumps(out, indent=2) + "\n")
