function _project_folder_name() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root="$PWD"
  basename "$root"
}

function _set_terminal_title() {
  printf '\033]0;%s\a' "$1"
}

function _prompt_terminal_title() {
  _set_terminal_title "$(pwd | sed -e "s;^$HOME;~;")"
}

function codex() {
  local title status
  title="codex $(_project_folder_name)"
  _set_terminal_title "$title"
  command codex "$@"
  status=$?
  _prompt_terminal_title
  return $status
}

function claude() {
  local title status
  title="claude $(_project_folder_name)"
  _set_terminal_title "$title"

  ~/.claude/set-tab-icon.sh running

  _claude_cleanup() {
    ~/.claude/set-tab-icon.sh clear
    _prompt_terminal_title
  }
  trap '_claude_cleanup' INT TERM HUP

  command claude "$@"
  status=$?
  trap - INT TERM HUP
  _claude_cleanup
  return $status
}

