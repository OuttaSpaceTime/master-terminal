#!/usr/bin/env bash
# claude-read: cooperatively read source code in Neovim, in small verified steps.
#
# Brings up Neovim in a kitty split on a socket THIS script chooses, then starts
# Claude Code with the nvim-mcp bridge pointed *explicitly* at that socket
# (--connect <socket>, never auto-discovery — which is fragile in worktrees and
# when the lazy nvim-mcp plugin hasn't loaded). The bridge is therefore live the
# moment Claude starts. `bundle open` and friends are forwarded into the same
# Neovim via $BUNDLER_EDITOR -> nvim-open.
#
# Governance is the `read` output style only (no guard hooks), scoped to this
# invocation via --settings, so nothing global changes and plain `claude` is
# unaffected.
#
# Usage:  claude-read [<target>] [claude args...]
#   <target>  a path (file or dir) OR a gem name to read. Default: current dir.
#             A gem name is resolved via `bundle show <name>` from the current
#             project (so `claude-read actionpack` opens the gem's source). Nvim
#             AND Claude are rooted at the target's project/gem root — the nearest
#             ancestor with .git, a *.gemspec, or a gems/ parent — so search, LSP,
#             and rubocop resolve within the thing you're reading, not the outer
#             worktree. Args starting with '-' go to claude.
set -euo pipefail

settings="$HOME/.claude/read/settings.json"
nvim_mcp_bin="$HOME/.cargo/bin/nvim-mcp"
if [[ ! -f "$settings" ]]; then
  echo "claude-read: missing $settings" >&2
  echo "Deploy it first:  chezmoi -S <master-terminal>/home apply" >&2
  exit 1
fi

# The project/gem root for a directory: nearest ancestor with .git, a *.gemspec, or
# a parent named "gems" (the rbenv/bundler gem layout). Falls back to the dir itself.
find_project_root() {
  local d g
  d=$(cd "$1" 2>/dev/null && pwd) || { printf '%s\n' "$1"; return; }
  while [[ "$d" != "/" ]]; do
    if [[ -e "$d/.git" ]] || [[ "$(basename "$(dirname "$d")")" == "gems" ]]; then
      printf '%s\n' "$d"; return
    fi
    for g in "$d"/*.gemspec; do
      [[ -e "$g" ]] && { printf '%s\n' "$d"; return; }
    done
    d=$(dirname "$d")
  done
  printf '%s\n' "$1"
}

# First non-flag argument is the target to read; the rest pass through to claude.
path="."
if [[ $# -gt 0 && "$1" != -* ]]; then
  path="$1"
  shift
fi

# Resolve the target. A path is used directly; a non-path is tried as a gem name
# via bundle (run from the CURRENT project, before we cd away).
if [[ "$path" == "." ]]; then
  abspath="$PWD"
elif [[ -e "$path" ]]; then
  abspath=$(realpath "$path")
else
  gem_path=$(timeout 20 bundle show "$path" 2>/dev/null | tail -n1 || true)
  if [[ -n "$gem_path" && -d "$gem_path" ]]; then
    abspath="$gem_path"
    echo "claude-read: resolved gem '$path' -> $abspath" >&2
  else
    abspath=$(realpath -m "$path" 2>/dev/null || echo "$path")
  fi
fi

# Root EVERYTHING at the target's project/gem root, so Nvim's :pwd, search, LSP,
# and Claude's own Read/Grep/Bash all resolve within the thing being read.
if [[ -d "$abspath" ]]; then start_dir="$abspath"; else start_dir=$(dirname "$abspath"); fi
root=$(find_project_root "$start_dir")
cd "$root" || true

# A socket WE control and pass explicitly to --connect. Keeping the
# nvim-mcp.<escaped-root>.*.sock naming means nvim-open's glob and any auto
# discovery can find it too, but the bridge does not depend on that.
sockdir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
sockdir="${sockdir%/}"
escaped="${root//\//%}"
socket="$sockdir/nvim-mcp.${escaped}.read-$$.sock"
rm -f "$socket"

# Open Neovim in a kitty split (a window in the current tab), listening on $socket.
bridge=""
if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitty >/dev/null 2>&1; then
  if kitty @ launch --type=window --cwd "$root" --title "read: $path" \
       nvim --listen "$socket" "$abspath" >/dev/null 2>&1; then
    # Wait for nvim to create the socket so the MCP server connects on startup.
    for _ in $(seq 1 50); do
      [[ -S "$socket" ]] && { bridge=1; break; }
      sleep 0.2
    done
  fi
fi

mcp_args=()
if [[ -n "$bridge" && -x "$nvim_mcp_bin" ]]; then
  # Per-invocation MCP config: connect DIRECTLY to this socket (proven reliable;
  # no project-root filtering, no ambiguity with other nvim instances).
  mcpcfg=$(mktemp "${TMPDIR:-/tmp}/claude-read-mcp.XXXXXX.json")
  cat >"$mcpcfg" <<EOF
{
  "mcpServers": {
    "nvim": {
      "command": "$nvim_mcp_bin",
      "args": ["--log-file", "/tmp/nvim-mcp.log", "--log-level", "info", "--connect", "$socket"]
    }
  }
}
EOF
  mcp_args=(--strict-mcp-config --mcp-config "$mcpcfg" --ide)
  # Forward editor-spawning commands (e.g. `bundle open <gem>`) into THIS Nvim.
  export BUNDLER_EDITOR="$HOME/.local/bin/nvim-open"
  export CLAUDE_READ_NVIM_SOCKET="$socket"
else
  echo "claude-read: could not bring up the Nvim bridge." >&2
  if [[ -z "${KITTY_WINDOW_ID:-}" ]]; then
    echo "             Not inside kitty — open Neovim yourself in this repo:" >&2
  elif [[ ! -x "$nvim_mcp_bin" ]]; then
    echo "             nvim-mcp not installed at $nvim_mcp_bin." >&2
  else
    echo "             Neovim's socket never appeared. Open it yourself:" >&2
  fi
  echo "             cd \"$root\" && nvim --listen \"$socket\" \"$abspath\"" >&2
  echo "             Claude will start WITHOUT the bridge; read mode will say so and stop." >&2
fi

exec claude --settings "$settings" "${mcp_args[@]}" --name read "$@"
