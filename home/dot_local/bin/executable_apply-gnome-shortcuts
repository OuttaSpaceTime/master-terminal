#!/usr/bin/env bash

set -euo pipefail

set_binding() {
  local schema=$1
  local key=$2
  local value=$3

  gsettings set "$schema" "$key" "$value"
}

apply_bindings() {
  gsettings set org.gnome.mutter dynamic-workspaces false
  gsettings set org.gnome.desktop.wm.preferences num-workspaces 4

  # Let dash-to-panel own the Super+1-9 app hotkeys without GNOME Shell also
  # binding them to the app switcher.
  set_binding org.gnome.shell.keybindings switch-to-application-1 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-2 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-3 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-4 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-5 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-6 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-7 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-8 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-9 "@as []"

  # Default terminal emulator = kitty.
  gsettings set org.gnome.desktop.default-applications.terminal exec 'kitty'
  gsettings set org.gnome.desktop.default-applications.terminal exec-arg ''

  # Custom keybindings list.
  gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings \
    "['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']"

  # Bluetooth audio profile toggle (WH-1000XM5): Super+Shift+i
  # (plain Super+i is silently grabbed by a shell extension on Wayland.)
  local base="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
  local path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/"
  gsettings set "${base}:${path}" name    "Toggle headset"
  gsettings set "${base}:${path}" command "${HOME}/.local/bin/bt-audio-toggle"
  gsettings set "${base}:${path}" binding "<Super><Shift>i"
}

apply_login_retries() {
  local delay

  apply_bindings

  # GNOME Shell and extensions may restore defaults later in session startup.
  # Reassert the mapping after a few delays so login races do not win.
  for delay in 5 15 30; do
    sleep "$delay"
    apply_bindings
  done
}

if [[ "${1:-}" == "--login" ]]; then
  apply_login_retries
else
  apply_bindings
fi
