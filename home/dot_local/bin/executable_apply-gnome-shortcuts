#!/usr/bin/env bash

set -euo pipefail

set_binding() {
  local schema=$1
  local key=$2
  local value=$3

  gsettings set "$schema" "$key" "$value"
}

apply_bindings() {
  gsettings set org.gnome.mutter dynamic-workspaces false
  gsettings set org.gnome.desktop.wm.preferences num-workspaces 4

  set_binding org.gnome.desktop.wm.keybindings switch-to-workspace-1 "['<Super>1']"
  set_binding org.gnome.desktop.wm.keybindings switch-to-workspace-2 "['<Super>2']"
  set_binding org.gnome.desktop.wm.keybindings switch-to-workspace-3 "['<Super>3']"
  set_binding org.gnome.desktop.wm.keybindings switch-to-workspace-4 "['<Super>4']"
  set_binding org.gnome.desktop.wm.keybindings move-to-workspace-1 "['<Shift><Super>1']"
  set_binding org.gnome.desktop.wm.keybindings move-to-workspace-2 "['<Shift><Super>2']"
  set_binding org.gnome.desktop.wm.keybindings move-to-workspace-3 "['<Shift><Super>3']"
  set_binding org.gnome.desktop.wm.keybindings move-to-workspace-4 "['<Shift><Super>4']"
  set_binding org.gnome.desktop.wm.keybindings move-to-workspace-left "@as []"
  set_binding org.gnome.desktop.wm.keybindings move-to-workspace-right "@as []"

  set_binding org.gnome.desktop.wm.keybindings switch-windows "['<Super>Tab']"
  set_binding org.gnome.desktop.wm.keybindings switch-windows-backward "['<Shift><Super>Tab']"
  set_binding org.gnome.desktop.wm.keybindings switch-applications "@as []"
  set_binding org.gnome.desktop.wm.keybindings switch-applications-backward "@as []"
  set_binding org.gnome.desktop.wm.keybindings switch-group "@as []"
  set_binding org.gnome.desktop.wm.keybindings switch-group-backward "@as []"
  set_binding org.gnome.desktop.wm.keybindings cycle-group "['<Shift><Super>grave']"
  set_binding org.gnome.desktop.wm.keybindings cycle-group-backward "['<Super>grave']"
  set_binding org.gnome.desktop.wm.keybindings cycle-windows "['<Super>Escape']"
  set_binding org.gnome.desktop.wm.keybindings cycle-windows-backward "@as []"
  set_binding org.gnome.settings-daemon.plugins.media-keys screensaver "['<Alt>Escape']"
  set_binding org.gnome.desktop.wm.keybindings close "['<Super>q', '<Super><Shift>q', '<Alt>F4', '<Super>w']"

  gsettings --schemadir "${HOME}/.local/share/gnome-shell/extensions/dash-to-panel@jderose9.github.com/schemas" \
    set org.gnome.shell.extensions.dash-to-panel hot-keys false

  set_binding org.gnome.shell.keybindings switch-to-application-1 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-2 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-3 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-4 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-5 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-6 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-7 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-8 "@as []"
  set_binding org.gnome.shell.keybindings switch-to-application-9 "@as []"

  # Default terminal emulator = kitty.
  gsettings set org.gnome.desktop.default-applications.terminal exec 'kitty'
  gsettings set org.gnome.desktop.default-applications.terminal exec-arg ''

  # Custom keybindings list.
  gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings \
    "['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']"

  # Bluetooth audio profile toggle (WH-1000XM5): Super+Shift+i
  # (plain Super+i is silently grabbed by a shell extension on Wayland.)
  local base="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
  local path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/"
  gsettings set "${base}:${path}" name    "Toggle headset"
  gsettings set "${base}:${path}" command "${HOME}/.local/bin/bt-audio-toggle"
  gsettings set "${base}:${path}" binding "<Super><Shift>i"
}

apply_login_retries() {
  local delay

  apply_bindings

  # GNOME Shell and extensions may restore defaults later in session startup.
  # Reassert the mapping after a few delays so login races do not win.
  for delay in 5 15 30; do
    sleep "$delay"
    apply_bindings
  done
}

if [[ "${1:-}" == "--login" ]]; then
  apply_login_retries
else
  apply_bindings
fi
