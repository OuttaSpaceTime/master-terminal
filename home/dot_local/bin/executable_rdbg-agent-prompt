#!/usr/bin/env ruby

require 'json'
require 'open3'

payload = JSON.parse($stdin.read)

question = payload.fetch('question')
reasoning = payload.fetch('reasoning', 'm')
debugger_context = payload.fetch('debugger_context')
metadata = payload.fetch('metadata', {})
session_id = payload['session_id']

effort =
  case reasoning.to_s.strip.downcase
  when 'l', 'low' then 'low'
  when 'm', 'medium' then 'medium'
  when 'h', 'high' then 'high'
  when 'x', 'xhigh', 'max' then 'xhigh'
  else
    raise ArgumentError, "invalid reasoning level #{reasoning.inspect}; use l, m, h, or x"
  end

instruction =
  if session_id && !session_id.empty?
    <<~PROMPT
      Response invariant: do not state any substantive fact, diagnosis, or behavioral claim unless you also show how the user could verify the same thing from this debugger. Use either visible evidence from the debugger context or a concrete rdbg/Ruby probe.

      Current debugger context:
      #{debugger_context}

      Session metadata: #{JSON.generate(metadata)}

      Question: #{question}
    PROMPT
    else
      <<~PROMPT
        You are a concise debugging sidecar for a Ruby debug.gem / rdbg session.

        The user is stopped in a live Ruby debugger. Use the captured debugger context as the primary context.
        Treat the context as authoritative and recent. Do not claim you can directly inspect the live process beyond what is included here.
        Before suggesting a root cause, anchor it in the actual app state visible in the debugger. If the answer depends on schema, model code, associations, runtime values, or another source file, tell the user exactly what to inspect next instead of guessing.
        Do not invent behavior from memory or fill gaps with speculation.
        Never state a substantive fact, diagnosis, or behavioral claim unless you also show how the user could verify the same thing from this debugger.

        Claim discipline:
        - If a claim is already supported by the debugger context, cite the visible cue briefly.
        - If a claim is not visible yet, phrase it as a hypothesis and include the exact probe that would confirm or falsify it.
        - Prefer probes the user can run immediately, such as `info locals`, `pp expr`, `bt`, `whereami`, `list`, `next`, `step`, `finish`, `break`, `catch`, `record on`, `step back`, `pp object.method(:name).source_location`, or a focused Ruby expression against the current frame.

        Respond with:
        1. A short answer to the question.
        2. Evidence or probes for every substantive claim.
        3. If relevant, one explicit prediction for what that probe should show.

        Keep it short and concrete. Prefer exact rdbg commands such as `info locals`, `pp expr`, `bt`, `whereami`, `list`, `next`, `step`, `finish`, `break`, `catch`, `record on`, or `step back`. When uncertain, pick the smallest probe that verifies the real app behavior.

        Session metadata:
        #{JSON.pretty_generate(metadata)}

      Debugger context:
      #{debugger_context}

      User question:
      #{question}
    PROMPT
  end

cmd = [
  'claude', '-p',
  '--verbose',
  '--output-format', 'stream-json',
  '--model', 'sonnet',
  '--allowed-tools', 'Read,Glob,Grep',
  '--effort', effort,
]

cmd << '--resume' << session_id if session_id && !session_id.empty?

cmd << instruction

stdout, stderr, status = Open3.capture3(
  { 'RUBY_DEBUG_ENABLE' => '0', 'RUBY_DEBUG_ADDED_RUBYOPT' => nil },
  *cmd
)

unless status.success?
  failure_text = [stderr, stdout].map(&:to_s).map(&:strip).reject(&:empty?).join("\n")
  warn(failure_text.empty? ? 'claude -p failed with no output' : failure_text)
  exit status.exitstatus || 1
end

result_line = stdout.each_line.filter_map { |l| JSON.parse(l.strip) rescue nil }.find { |obj| obj['type'] == 'result' }

if result_line
  print JSON.generate({ 'text' => result_line['result'], 'session_id' => result_line['session_id'] })
else
  warn 'Could not parse claude response'
  print JSON.generate({ 'text' => stdout.strip, 'session_id' => nil })
end
