#!/usr/bin/env bash
# claude-solve: run Claude Code in SolveIt mode.
#
# The human is the agent and sets direction; Claude moves in small, verifiable
# steps. Enforcement is scoped to THIS invocation via --settings (the solveit
# output style + PreToolUse hooks) — nothing in your global config changes, so
# a plain `claude` session is unaffected.
#
# Hard limits enforced by the hooks:
#   - <=20 added lines per edit, and <20 uncommitted lines per repo (checkpoint)
#     — the SAME cap for the main repo and for a .claude/tasks/ scratch repo
#   - <=4 numbered work files per .claude/tasks/<name>/ folder
#   - the agent NEVER commits anything (main or scratch) — changes stay dirty so
#     the human verifies and commits; only `git init` + read-only git are allowed
#   - Bash only runs task scripts under .claude/tasks/ and read-only inspection:
#     searches (grep/rg/find/ls/cat/awk/…, incl. for/while/if loops over them, no
#     redirect, no find -exec/-delete) and read-only git (diff/status/log/show/…).
#     Read/Grep/Glob, shell searches, and read-only git log to .claude/solveit/reads.log
set -euo pipefail

settings="$HOME/.claude/solveit/settings.json"
if [[ ! -f "$settings" ]]; then
  echo "claude-solve: missing $settings" >&2
  echo "Deploy it first:  chezmoi -S <master-terminal>/home apply" >&2
  exit 1
fi

exec claude --settings "$settings" --name solveit "$@"
