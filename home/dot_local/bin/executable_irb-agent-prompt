#!/usr/bin/env ruby

require 'json'
require 'open3'

payload = JSON.parse($stdin.read)

question = payload.fetch('question')
range = payload.fetch('range')
reasoning = payload.fetch('reasoning', 'm')
transcript = payload.fetch('transcript')
metadata = payload.fetch('metadata', {})
session_id = payload['session_id']

effort =
  case reasoning.to_s.strip.downcase
  when 'l', 'low' then 'low'
  when 'm', 'medium' then 'medium'
  when 'h', 'high' then 'high'
  when 'x', 'xhigh', 'max' then 'xhigh'
  else
    raise ArgumentError, "invalid reasoning level #{reasoning.inspect}; use l, m, h, or x"
  end

instruction =
  if session_id && !session_id.empty?
    <<~PROMPT
      New console statements since the last Claude call:
      #{transcript}

      Session metadata: #{JSON.generate(metadata)}

      Question: #{question}
    PROMPT
  else
    <<~PROMPT
      You are a concise debugging sidecar for a Ruby IRB / Rails console session.

      The user is asking a question about their live console work. Use the transcript window as the primary context.
      Treat the transcript as authoritative and recent. Do not claim you can directly inspect the live process beyond what is included here.
      Before suggesting a diagnosis, anchor it in the actual app state that is visible from the console. If the answer depends on schema, model, source, associations, or runtime data, say exactly what to inspect next instead of guessing.
      Do not invent behavior from memory or fill gaps with speculation.

      Respond with:
      1. A short answer to the question.
      2. The next probe or command to run in the console.
      3. If relevant, one explicit prediction for what that probe should show.

      Keep it short and concrete. Prefer executable probes over general advice. When uncertain, ask for the smallest verification step against the real app.

      Session metadata:
      #{JSON.pretty_generate(metadata)}

      Included statement range: #{range == 0 ? 'all new statements' : "last #{range} new statements"}

      Transcript:
      #{transcript}

      User question:
      #{question}
    PROMPT
  end

cmd = [
  'claude', '-p',
  '--output-format', 'stream-json',
  '--model',
  'sonnet',
  '--allowed-tools',
  'Read,Glob,Grep',
  '--effort', effort,
]

cmd << '--resume' << session_id if session_id && !session_id.empty?

cmd << instruction

stdout, stderr, status = Open3.capture3(*cmd)

unless status.success?
  failure_text = [stderr, stdout].map(&:to_s).map(&:strip).reject(&:empty?).join("\n")
  warn(failure_text.empty? ? 'claude -p failed with no output' : failure_text)
  exit status.exitstatus || 1
end

result_line = stdout.each_line.filter_map { |l| JSON.parse(l.strip) rescue nil }.find { |obj| obj['type'] == 'result' }

if result_line
  print JSON.generate({ 'text' => result_line['result'], 'session_id' => result_line['session_id'] })
else
  warn 'Could not parse claude response'
  print JSON.generate({ 'text' => stdout.strip, 'session_id' => nil })
end
