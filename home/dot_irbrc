module IRBClaudeAgent
  StatementRecord = Struct.new(:index, :code, :status, :value_preview, :exception_class, :exception_message, keyword_init: true)

  class Recorder
    DEFAULT_RANGE = 8
    MAX_STATEMENTS = 200
    MAX_PREVIEW_LENGTH = 1_200

    def initialize
      @entries = []
      @next_index = 1
    end

    def record_success(code, value)
      @entries << StatementRecord.new(
        index: next_index,
        code: code,
        status: :ok,
        value_preview: truncate(safe_inspect(value))
      )
      trim!
    end

    def record_error(code, exception)
      @entries << StatementRecord.new(
        index: next_index,
        code: code,
        status: :error,
        exception_class: exception.class.name,
        exception_message: truncate(exception.message.to_s, 400)
      )
      trim!
    end

    def slice(range = DEFAULT_RANGE)
      if range.to_i <= 0
        @entries.dup
      else
        @entries.last(range.to_i)
      end
    end

    def since(index, range = DEFAULT_RANGE)
      entries = @entries.select { |entry| entry.index > index.to_i }
      return entries if range.to_i <= 0

      entries.last(range.to_i)
    end

    def latest_index
      @entries.last&.index || 0
    end

    def clear
      @entries.clear
    end

    def empty?
      @entries.empty?
    end

    private

    def next_index
      current = @next_index
      @next_index += 1
      current
    end

    def trim!
      @entries.shift while @entries.length > MAX_STATEMENTS
    end

    def safe_inspect(value)
      value.inspect
    rescue StandardError => err
      "#<inspect failed: #{err.class}: #{err.message}>"
    end

    def truncate(text, limit = MAX_PREVIEW_LENGTH)
      return text if text.length <= limit

      "#{text[0, limit]}..."
    end
  end

  class << self
    attr_accessor :session_id, :last_sent_index

    def recorder
      @recorder ||= Recorder.new
    end

    def ask(text, range = Recorder::DEFAULT_RANGE, reasoning = :m)
      question = text.to_s.strip
      raise ArgumentError, 'claude(text, range): text must not be empty' if question.empty?

      transcript = render_transcript_since(last_sent_index.to_i, range)
      payload = {
        question: question,
        range: range.to_i,
        reasoning: reasoning.to_s.strip.downcase,
        transcript: transcript,
        metadata: metadata,
        session_id: session_id
      }

      cmd = [File.expand_path('~/.local/bin/irb-agent-prompt')]
      stdout, stderr, status = Open3.capture3(*cmd, stdin_data: JSON.generate(payload))

      unless status.success?
        details = [stderr.strip, stdout.strip].reject(&:empty?).join("\n")
        details = 'no output from helper script' if details.empty?
        raise "irb-agent-prompt failed (#{status.exitstatus}): #{details}"
      end

      begin
        response = JSON.parse(stdout)
        self.session_id = response['session_id'] if response['session_id']
        puts response['text'].to_s.strip
        arm_prefill(response['next_input']) if response['next_input']
      rescue JSON::ParserError
        puts stdout.strip
      end

      self.last_sent_index = recorder.latest_index
      nil
    end

    def trackable_statement?(code)
      stripped = code.to_s.strip
      return false if stripped.empty?

      !stripped.match?(/\A(claude|prompt_history|prompt_history_clear)\b/)
    end

    def render_transcript(range)
      entries = recorder.slice(range)
      render_entries(entries, "No REPL statements have been recorded in this session yet.")
    end

    def render_transcript_since(index, range)
      entries = recorder.since(index, range)
      render_entries(entries, "No new REPL statements have been recorded since the last Claude call.")
    end

    def render_entries(entries, empty_message)
      return empty_message if entries.empty?

      entries.map do |entry|
        lines = ["[#{entry.index}] input:", entry.code.rstrip]
        if entry.status == :ok
          lines << "[#{entry.index}] result:"
          lines << entry.value_preview.to_s
        else
          lines << "[#{entry.index}] exception:"
          lines << "#{entry.exception_class}: #{entry.exception_message}"
        end
        lines.join("\n")
      end.join("\n\n")
    end

    def arm_prefill(code)
      Reline.pre_input_hook = -> {
        Reline.insert_text(code)
        Reline.redisplay
        Reline.pre_input_hook = nil
      }
    end

    def metadata
      {
        ruby_version: RUBY_VERSION,
        irb_version: defined?(IRB::VERSION) ? IRB::VERSION : nil,
        rails_env: (Rails.env if defined?(Rails) && Rails.respond_to?(:env)),
        pwd: Dir.pwd
      }.compact
    end
  end
end

IRBClaudeAgent.last_sent_index = 0

module IRBClaudeAgentContextCapture
  def evaluate(statement, line_no)
    super.tap do
      if statement.is_a?(IRB::Statement::Expression) && IRBClaudeAgent.trackable_statement?(statement.code)
        IRBClaudeAgent.recorder.record_success(statement.code, last_value)
      end
    end
  rescue SystemExit, SignalException
    raise
  rescue Interrupt, Exception => exc
    if statement.respond_to?(:code) && IRBClaudeAgent.trackable_statement?(statement.code)
      IRBClaudeAgent.recorder.record_error(statement.code, exc)
    end
    raise
  end
end

IRB::Context.prepend(IRBClaudeAgentContextCapture) if defined?(IRB::Context)

