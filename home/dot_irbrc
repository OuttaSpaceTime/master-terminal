def claude(text, range = IRBClaudeAgent::Recorder::DEFAULT_RANGE, reasoning = :m)
  question = text.to_s.strip
  raise ArgumentError, 'claude(text, range): text must not be empty' if question.empty?

  transcript = IRBClaudeAgent.render_transcript(range)
  payload = {
    question: question,
    range: range.to_i,
    reasoning: reasoning.to_s.strip.downcase,
    transcript: transcript,
    metadata: IRBClaudeAgent.metadata
  }

  cmd = [File.expand_path('~/.local/bin/irb-agent-prompt')]
  stdout, stderr, status = Open3.capture3(*cmd, stdin_data: JSON.generate(payload))

  unless status.success?
    details = [stderr.strip, stdout.strip].reject(&:empty?).join("\n")
    details = 'no output from helper script' if details.empty?
    raise "irb-agent-prompt failed (#{status.exitstatus}): #{details}"
  end

  puts stdout.strip
  nil
end

alias prompt claude

def prompt_history(range = IRBClaudeAgent::Recorder::DEFAULT_RANGE)
  puts IRBClaudeAgent.render_transcript(range)
  nil
end

def prompt_history_clear
  IRBClaudeAgent.recorder.clear
  nil
end
