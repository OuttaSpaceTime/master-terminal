def set_current(membership_or_id)
  membership =
    membership_or_id.is_a?(Membership) ? membership_or_id : Membership.unscoped.find(membership_or_id)

  Current.set_from_membership(membership)
end

def claude(text, range = IRBClaudeAgent::Recorder::DEFAULT_RANGE, reasoning = :m)
  IRBClaudeAgent.ask(text, range, reasoning)
end

class IRBClaudeCommand < IRB::Command::Base
  category 'Claude'
  description 'Send the rest of the line to the IRB Claude sidecar.'

  def execute(arg)
    IRBClaudeAgent.ask(arg)
  end
end

IRB::Command.register(:claude, IRBClaudeCommand)

def prompt_history(range = IRBClaudeAgent::Recorder::DEFAULT_RANGE)
  puts IRBClaudeAgent.render_transcript(range)
  nil
end

def prompt_history_clear
  IRBClaudeAgent.recorder.clear
  nil
end
