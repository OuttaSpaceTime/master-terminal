{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-edit-archive.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(chezmoi -S home diff:*)",
      "Bash(chezmoi -S home apply:*)",
      "Bash(uv run pytest:*)"
    ]
  }
}
